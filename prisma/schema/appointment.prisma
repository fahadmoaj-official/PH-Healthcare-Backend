model Appointment {
    id          String   @id @default(uuid())
    status      AppointmentStatus @default(PENDING) 
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt 

    // patientId   String
    // patient     User @relation(fields: [patientId], references: [id])

    payment Payment?
    @@map("appointments")
}