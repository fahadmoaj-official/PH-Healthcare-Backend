model Payment{
    id          String   @id @default(uuid())
    status      PaymentStatus @default(UNPAID) 
    amount      Decimal  @db.Decimal(10, 2)
    currency    String @default("BDT")
    paymentMethod String @default("Bkash")
    merchantInvoiceNumber String @unique // appointmentId

// after completion of payment, these fields will be filled
    bkashPaymentId String? @unique
    bkashTrxId String? @unique
    payerReference String? @unique       //number | email
    PaidAt String?

    gatewayResponse Json?             // the full response from the payment gateway, after payment completion

    refundTrxId String? @unique
    refundAmount Decimal? @db.Decimal(10, 2)
    refundReason String?
    refundAt String?

    appointmentId String @unique
    appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt 

    @@map("payments")
}